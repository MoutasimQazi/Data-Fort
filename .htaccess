# Datafort — document root .htaccess
#
# READ THIS BEFORE RELYING ON ANY OF IT
#
# .htaccess CANNOT enforce mutual TLS. It runs after Apache has already
# accepted the connection, so by the time these rules execute the
# decision about whether a client certificate was required has already
# been made — in the vhost, by SSLVerifyClient.
#
# What this file does: forces HTTPS, hides files that should not be
# served, sets security headers, and (optionally) sends certificate-less
# visitors somewhere that explains itself instead of a bare 403.
#
# What actually enforces the device rule: apache/datafort-mtls.conf.
# See requirements section 24.


# ══ Force HTTPS ═══════════════════════════════════════════════════
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>


# ══ Friendly refusal for unenrolled devices ═══════════════════════
#
# Only enable this alongside `SSLVerifyClient optional` in the vhost.
#
# With `optional`, a laptop without a certificate still completes the
# handshake, so we can serve it a page that explains what is wrong —
# far better than a browser-level TLS error the employee cannot read.
#
# With `require`, the connection is refused during the handshake and
# this rule never runs; the user sees a raw browser error instead. That
# is more secure and much worse to support, which is the trade-off.
#
# Left commented out because with mTLS not yet configured,
# SSL_CLIENT_VERIFY is empty and this would redirect EVERY visitor,
# including into a loop on no-device.html itself.
#
# The public marketing pages must be excluded too, and the bare "/"
# with them — landing.html is the DirectoryIndex, so without that first
# condition enabling this rule would put the whole public site behind a
# client certificate. A prospect does not have one and never will.
#
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{REQUEST_URI} ^/$ [OR]
#     RewriteCond %{REQUEST_URI} ^/(landing|pricing)\.html$
#     RewriteRule ^ - [L]
#
#     RewriteCond %{REQUEST_URI} !^/no-device\.html$
#     RewriteCond %{REQUEST_URI} !^/(style|app|login|guard)\.css$
#     RewriteCond %{REQUEST_URI} !^/(theme)\.js$
#     RewriteCond %{REQUEST_URI} !^/brand/
#     RewriteCond %{SSL:SSL_CLIENT_VERIFY} !=SUCCESS
#     RewriteRule ^ /no-device.html?reason=no_certificate [L,R=302]
# </IfModule>


# ══ Never serve these ═════════════════════════════════════════════
<FilesMatch "\.(sql|md|log|bak|save|swp|conf|sample\.php)$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# The Apache config template documents the security boundary and the CA
# paths. No reason for it to be web-readable.
#
# private-ca/ holds CA private keys (see CERTIFICATES.md) — every
# control in api/device.php is decorative if that directory is ever
# reachable over HTTP, so it is blocked here as a second line, not
# relied on as the only one: the keys should never be inside the web
# docroot at all (CERTIFICATES.md says so), this is defence in depth
# for the time between "generated" and "moved out."
#
# scripts/ holds CLI-only provisioning tools (multi-tenant setup). Each
# one already refuses to run outside PHP_SAPI === 'cli', so this does
# not change what they can do — it just stops them being invoked as a
# web request at all, consistent with db.php/auth.php/device.php below
# never being directly reachable either.
<IfModule mod_alias.c>
    RedirectMatch 404 ^/apache/
    RedirectMatch 404 ^/private-ca/
    RedirectMatch 404 ^/scripts/
</IfModule>


# ══ Headers ═══════════════════════════════════════════════════════
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

    # Pages showing lead data must never sit in a shared cache, and must
    # not be restorable from the back/forward cache after sign-out.
    <FilesMatch "\.(html)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, private"
    </FilesMatch>
</IfModule>


# ══ Content Security Policy ═══════════════════════════════════════
#
# Google Fonts is the only external origin. Everything else is same-origin.
# 'unsafe-inline' for styles is needed by the inline style attributes in
# the current markup — worth removing later by moving them into the
# stylesheets, at which point this can be tightened to 'self' only.
#
# img-src needs BOTH:
#   data:  for the inline SVG chevron baked into .select in app.css
#   blob:  for revealed contact values. api/lead-reveal.php returns a
#          PNG, api.js wraps it with URL.createObjectURL, and that
#          produces a blob: URL. Without blob: here, every reveal shows
#          a broken image and the only clue is a console CSP violation.
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>


# ══ Misc ══════════════════════════════════════════════════════════
Options -Indexes
# landing.html first: the document root is a public marketing surface,
# not the sign-in screen. A prospect who types the bare domain gets the
# page that explains the product; login.html is still one click away in
# the nav, and every in-app redirect targets it by name (api.js,
# app.js, reset.html) so none of them depend on this order.
DirectoryIndex landing.html index.html
